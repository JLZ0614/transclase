# 对外域名，Caddy 会为它自动申请证书
DOMAIN=api.example.com

# 会话签名密钥，用 openssl rand -hex 32 生成
SESSION_SECRET=change-me

# 管理员账号
ADMIN_USERNAME=root
ADMIN_PASSWORD=change-me-too

# DeepSeek 上游
DEEPSEEK_KEY=sk-your-deepseek-key

# 客户端看到的模型名 → 上游真实模型
ALIAS_CHAT=transclase-chat
ALIAS_REASONER=transclase-reasoner
UPSTREAM_CHAT=deepseek-chat
UPSTREAM_REASONER=deepseek-reasoner

TZ=Asia/Shanghai
