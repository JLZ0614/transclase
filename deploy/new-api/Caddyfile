{$DOMAIN} {
	encode zstd gzip

	# 中转本身的接口
	handle /v1/* {
		reverse_proxy new-api:3000
	}

	# 管理后台与静态资源
	handle {
		reverse_proxy new-api:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
